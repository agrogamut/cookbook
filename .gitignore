.env
.env.local
/bin/
.unlazy/

# External datasets are downloaded, not authored here. scripts/fetch_data.fish fetches
# them and verifies them against data/external/SHA256SUMS, which IS tracked.
data/external/*.csv

# Recipe photo candidates are fetched, not authored here. cmd/photomatch -fetch pulls
# them; SHA256SUMS covers the CSVs above but not these binaries directly.
data/external/photos/

# Sample books generated locally for a look-at-the-pages check, not source material.
/sample-books/

# Ad-hoc fact-check notes against a specific generated book run, not project documentation.
/docs/audits/
