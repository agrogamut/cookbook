.env
.env.local
/bin/
.unlazy/

# External datasets are downloaded, not authored here. scripts/fetch_data.fish fetches
# them and verifies them against data/external/SHA256SUMS, which IS tracked.
data/external/*.csv

# Recipe photo candidates, fetched by the dish-format photography pipeline that migration
# 0031 deleted. Kept ignored rather than dropped: any working tree that ran the old
# cmd/photomatch -fetch still has this directory, and untracking it would turn a few hundred
# stale image files into untracked noise in every git status.
data/external/photos/

# Sample books generated locally for a look-at-the-pages check, not source material.
/sample-books/

# Ad-hoc fact-check notes against a specific generated book run, not project documentation.
/docs/audits/
