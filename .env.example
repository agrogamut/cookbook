# Copy to .env and fill in. .env is never committed.

# Postgres. Local development uses the throwaway container from scripts/dev_db.fish.
# Production (Supabase) must use the transaction pooler on port 6543, never the
# direct IPv6-only host.
# Startup migrations use the same hosted pooler's session port (5432) for locks.
DATABASE_URL=postgres://recipie:recipie@localhost:55432/recipie?sslmode=disable

# Directory holding the 13 provider workbooks. Defaults to data/provider.
XLSX_DIR=data/provider

# HTTP listen port. Unused until phase 2.
PORT=8080

# Set to a throwaway database to run the integrity suite. Unset, the suite skips.
TEST_DATABASE_URL=postgres://recipie:recipie@localhost:55432/recipie?sslmode=disable

# Optional. Enables internal/aidraft: live Gemini-drafted clinical modification notes and
# the invented-recipe fallback for a meal chapter that falls short of its target after real
# corpus recipes are exhausted. Unset, both features stay off -- chapters that fall short
# just report the gap, same as before this feature existed. Get a key at
# https://ai.google.dev/gemini-api/docs/api-key
GEMINI_API_KEY=

# Public site origin, with no trailing path. HTTPS enables Secure session cookies.
APP_ORIGIN=http://localhost:3000

# Staff sign-in and account administration. Both must be set together.
# Use the project URL and a server-only secret key (or legacy service-role key).
# DATABASE_URL above should point to the same Supabase project's transaction pooler.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Optional consultation checkout. Use matching test keys while verifying the setup.
# All three values are needed before checkout becomes available.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional isolated database for portal integration tests. Never use a live database.
PORTAL_TEST_DATABASE_URL=

# Optional server-only 32-byte payout encryption key, encoded as 64 hex characters.
# Keep this key stable and backed up. Missing key disables payout destinations/requests.
WALLET_ENCRYPTION_KEY=

# Owner-selected 18% defaults for NEW orders/withdrawals, not evidence of tax advice.
# Accepted values: owner-18-v1 (also the empty default), inactive.
# Set BOTH to inactive before API-first rollout; enable after new UI verification.
# Existing orders/requests retain snapshots. See docs/consultation-wallet.md.
PORTAL_PATIENT_TAX_POLICY=owner-18-v1
PORTAL_WITHDRAWAL_DEDUCTION_POLICY=owner-18-v1

# Temporary API-first family-form rollout only. Empty enforces guardian name.
# Absolute RFC3339 deadline, at most 24 hours ahead; expires without a restart.
PORTAL_LEGACY_GUARDIAN_UNTIL=
