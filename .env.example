# Copy to .env and fill in. .env is never committed.

# Postgres. Local development uses the throwaway container from scripts/dev_db.fish.
# Production (Supabase) must use the transaction pooler on port 6543, never the
# direct IPv6-only host.
DATABASE_URL=postgres://recipie:recipie@localhost:55432/recipie?sslmode=disable

# Directory holding the 13 provider workbooks. Defaults to data/provider.
XLSX_DIR=data/provider

# HTTP listen port. Unused until phase 2.
PORT=8080

# Set to a throwaway database to run the integrity suite. Unset, the suite skips.
TEST_DATABASE_URL=postgres://recipie:recipie@localhost:55432/recipie?sslmode=disable

# Optional. Enables internal/aidraft: live Gemini-drafted clinical modification notes and
# the invented-recipe fallback for a meal chapter that falls short of its target after real
# corpus recipes are exhausted. Unset, both features stay off -- chapters that fall short
# just report the gap, same as before this feature existed. Get a key at
# https://ai.google.dev/gemini-api/docs/api-key
GEMINI_API_KEY=
